# Block direct web access to internal PHP files and data. index.php stays public.
<FilesMatch "^(config|lib|setup|migrate|projects|core|mail|auth|seed_extended)\.php$">
    Require all denied
</FilesMatch>

# Let the Authorization header reach PHP (needed for MCP / API tokens on some Apache + FastCGI hosts)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^\.well-known/(openid-configuration|oauth-authorization-server)$ oauth.php?r=as-metadata [L]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
