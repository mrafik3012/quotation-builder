Options -Indexes
DirectoryIndex index.html

# Never serve internals: database files, tests, scripts, docs source, VCS data
<FilesMatch "\.(sqlite|sqlite3|db|sh|md|log|sql|bak)$">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(.*/)?(\.git|tests)(/|$)
</IfModule>

<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# OAuth discovery addresses that connector apps look for at the site root (works when the app is installed at the domain root)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.well-known/oauth-authorization-server(/.*)?$ api/oauth.php?r=wk-authorization-server [L,QSA]
    RewriteRule ^\.well-known/oauth-protected-resource(/.*)?$ api/oauth.php?r=wk-protected-resource [L,QSA]
</IfModule>

# Force HTTPS (Hostinger provides free SSL) - uncomment once SSL is active
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
