Options -Indexes
DirectoryIndex index.html

# Never serve internals: database files, tests, scripts, docs source, VCS data
<FilesMatch "\.(sqlite|sqlite3|db|sh|md|log|sql|bak)$">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(.*/)?(\.git|tests)(/|$)
</IfModule>

<IfModule mod_headers.c>
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Force HTTPS (Hostinger provides free SSL) - uncomment once SSL is active
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
